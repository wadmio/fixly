{
  "name": "fixly-vscode",
  "displayName": "Fixly",
  "description": "Scan your project's npm dependencies for known vulnerabilities (OSV).",
  "version": "0.1.0",
  "private": true,
  "publisher": "fixly",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Linters", "Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fixly.scanCurrentProject",
        "title": "Fixly: Scan Current Project"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fixly/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3"
  }
}
