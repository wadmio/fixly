{
  "name": "fixly-cli",
  "version": "0.1.0",
  "description": "Fixly — dependency security for vibecoders. Vibecheck your project, verify packages before installing, gate your CI.",
  "private": true,
  "type": "module",
  "bin": {
    "fixly": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fixly/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
